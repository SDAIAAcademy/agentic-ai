# Copy to labs/.env and fill in. Never commit .env.

# Required: an OpenRouter key (https://openrouter.ai/keys). The labs use free models only.
# Free models allow 50 requests a day; a one-time purchase of 10 credits raises that to 1,000 a day
# (still free models, nothing is spent). Repeated identical requests are served from labs/cache.
OPENROUTER_API_KEY=

# Optional: a Hugging Face token (https://huggingface.co/settings/tokens, fine-grained,
# "Make calls to Inference Providers"). Used for the HF MCP server and, with credits, HF Inference Providers.
HF_TOKEN=

# Optional overrides
# AGENT_PROVIDER=openrouter        # openrouter | hf | custom
# AGENT_MODEL=google/gemma-4-31b-it:free
# AGENT_SMALL_MODEL=google/gemma-4-26b-a4b-it:free
# AGENT_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# AGENT_CACHE=1                    # 0 = always call the model
# AGENT_QUICK=1                    # smaller workloads

# Optional: any engine that serves the OpenAI and Anthropic API shapes (vLLM, SGLang, llama.cpp, Ollama, LM Studio, LiteLLM)
# AGENT_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_ANTHROPIC_BASE_URL=http://localhost:11434
# LLM_API_KEY=none
# LLM_MODEL=qwen3.5:4b
